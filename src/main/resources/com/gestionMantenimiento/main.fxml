<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" prefHeight="780.0" prefWidth="920.0"
            style="-fx-background-color: #F0F0F0;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestionMantenimiento.Controller.MainController">

<left>
    <VBox prefWidth="115" spacing="0" style="-fx-background-color: #2C2C2C;">

        <HBox alignment="CENTER" prefHeight="58" style="-fx-background-color: #3A3A3A; -fx-padding: 10;">
            <VBox alignment="CENTER" spacing="2"
                  style="-fx-background-color: #D3D3D3; -fx-background-radius: 8; -fx-padding: 6 10;">
                <Label text="GM" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"/>
            </VBox>
        </HBox>

        <!-- Rol -->
        <HBox alignment="CENTER" style="-fx-padding: 8 4 4 4;">
            <Label fx:id="lblNombre" text=""
                   style="-fx-font-size: 11px; -fx-text-fill: #FFFFFF; -fx-font-weight: bold;"/>
            <Label fx:id="lblRol" text="Rol"
                   style="-fx-font-size: 10px; -fx-text-fill: #888888; -fx-font-style: italic;"/>
        </HBox>

        <!-- Botones navegación -->
        <VBox spacing="3" style="-fx-padding: 4 6 8 6;">
            <Button fx:id="btnDashboard" alignment="CENTER_LEFT" prefHeight="36" prefWidth="103"
                    text="  Dashboard" onAction="#irDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: #AAAAAA; -fx-font-size: 11px; -fx-padding: 4 10; -fx-border-radius: 5; -fx-background-radius: 5;"/>
            <Button fx:id="btnSolicitudes" alignment="CENTER_LEFT" prefHeight="36" prefWidth="103"
                    text="  Solicitudes" onAction="#irSolicitudes"
                    style="-fx-background-color: transparent; -fx-text-fill: #AAAAAA; -fx-font-size: 11px; -fx-padding: 4 10; -fx-border-radius: 5; -fx-background-radius: 5;"/>
            <Button fx:id="btnTecnicos" alignment="CENTER_LEFT" prefHeight="36" prefWidth="103"
                    text="  Tecnicos" onAction="#irTecnicos"
                    style="-fx-background-color: transparent; -fx-text-fill: #AAAAAA; -fx-font-size: 11px; -fx-padding: 4 10; -fx-border-radius: 5; -fx-background-radius: 5;"/>
            <Button fx:id="btnReportes" alignment="CENTER_LEFT" prefHeight="36" prefWidth="103"
                    text="  Reportes" onAction="#irReportes"
                    style="-fx-background-color: transparent; -fx-text-fill: #AAAAAA; -fx-font-size: 11px; -fx-padding: 4 10; -fx-border-radius: 5; -fx-background-radius: 5;"/>
            <Button fx:id="btnHistorial" alignment="CENTER_LEFT" prefHeight="36" prefWidth="103"
                    text="  Historial" onAction="#irHistorial"
                    style="-fx-background-color: transparent; -fx-text-fill: #AAAAAA; -fx-font-size: 11px; -fx-padding: 4 10; -fx-border-radius: 5; -fx-background-radius: 5;"/>
            <Button fx:id="btnConfiguracion" alignment="CENTER_LEFT" prefHeight="36" prefWidth="103"
                    text="  Configuracion" onAction="#irConfiguracion"
                    style="-fx-background-color: transparent; -fx-text-fill: #AAAAAA; -fx-font-size: 11px; -fx-padding: 4 10; -fx-border-radius: 5; -fx-background-radius: 5;"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <VBox style="-fx-padding: 6 6 14 6;">
            <Button alignment="CENTER_LEFT" prefHeight="36" prefWidth="103"
                    text="  Cerrar Sesion" onAction="#cerrarSesion"
                    style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-font-size: 11px; -fx-padding: 4 10; -fx-border-radius: 5; -fx-background-radius: 5;"/>
        </VBox>
    </VBox>
</left>

<center>
    <StackPane fx:id="contentArea" style="-fx-background-color: #F0F0F0;"/>
</center>

</BorderPane>
